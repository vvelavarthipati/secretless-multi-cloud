# Copy this file to terraform.tfvars and replace the values below
# with your own GitHub repository and AWS region.

aws_region         = "<AWS_REGION>"
github_repository  = "<GITHUB_OWNER>/<GITHUB_REPOSITORY>"
github_environment = "demo"
role_name          = "secretless-multicloud-github"

# No AWS access keys, GitHub tokens, bucket ARNs, or other credentials belong here.
# The S3 bucket is created by Terraform.
